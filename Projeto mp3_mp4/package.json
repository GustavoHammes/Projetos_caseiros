{
  "name": "super-baixador", "version": "2.0.0", "private": true,
  "scripts": {
    "start": "npm --prefix backend start",
    "setup": "node scripts/setup-windows.js",
    "setup:pc": "node scripts/setup-windows.js && node scripts/setup-cloudflared.js",
    "pc:start": "node scripts/pc-server.js start",
    "pc:status": "node scripts/pc-server.js status",
    "pc:stop": "node scripts/pc-server.js stop",
    "pc:restart": "node scripts/pc-server.js restart",
    "pc:open": "node scripts/pc-server.js open",
    "pc:autostart": "node scripts/pc-server.js install-startup",
    "pc:autostart:remove": "node scripts/pc-server.js uninstall-startup",
    "test": "npm --prefix backend test",
    "doctor": "npm --prefix backend run doctor",
    "deploy:koyeb": "node scripts/deploy-koyeb.js",
    "test:live": "npm --prefix backend run test:live"
  },
  "engines": { "node": ">=22" }
}
